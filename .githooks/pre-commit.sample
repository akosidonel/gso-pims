#!/usr/bin/env bash
# Sample hook that keeps release commits clean and intentional.
# Copy to .git/hooks/pre-commit and make executable to use.

if git diff --cached --name-only | grep -q '^CHANGELOG\.md$'; then
  if ! git diff --cached --name-only | grep -q '^tools/release\.php$'; then
    echo "[pre-commit] CHANGELOG.md is usually generated by php tools/release.php." >&2
    echo "             Make sure this changelog edit is intentional." >&2
  fi
fi

exit 0
